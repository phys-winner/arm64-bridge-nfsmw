+                                (unsigned long)current_addr, (unsigned long)target);
             throw OaknutException{ExceptionType::OffsetOutOfRange};
+        }
         diff &= detail::mask_from_size(bitsize);
         return static_cast<std::uint32_t>(((diff & 3) << (bitsize - 2)) | (diff >> 2));
     }
