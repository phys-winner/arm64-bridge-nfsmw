 #include <cstddef>
 #include <cstdint>
@@ -52,8 +54,11 @@ struct AddrOffset {
     static std::uint32_t encode(std::ptrdiff_t diff)
     {
         const std::uint64_t diff_u64 = static_cast<std::uint64_t>(diff);
